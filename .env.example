# Copy this file to backend/.env and fill in real values before starting.
# Never commit .env to source control.

# API key checked on every inbound request via X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOADS_API_KEY=your-loads-api-key-here

# FMCSA API key for carrier authority verification.
FMCSA_API_KEY=your-fmcsa-api-key-here

# SQLite database path (relative to backend/ when running uvicorn from there).
# Default is fine for local dev; override in production if needed.
DATABASE_URL=sqlite+aiosqlite:///./carrier_sales.db

# -------------------------------------------------------------------------
# Frontend (frontend/.env) — copy and fill separately
# -------------------------------------------------------------------------
# Base URL of the API. Leave empty when served by the same origin (production).
# Set to http://localhost:8000 only if running frontend dev server separately.
VITE_API_BASE=

# Must match LOADS_API_KEY above.
VITE_API_KEY=your-loads-api-key-here
