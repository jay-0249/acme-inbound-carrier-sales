# Copy this file to backend/.env and fill in real values before starting.
# Never commit .env to source control.

# Full-access API key. Used by the HappyRobot agent (POST /calls, POST /negotiate)
# and also accepted on all read endpoints. Never ship this to the browser.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOADS_API_KEY=your-loads-api-key-here

# Read-only API key. Accepted on GET /metrics, GET /loads, GET /loads/{id},
# GET /verify-carrier. This is the key baked into the browser bundle (VITE_API_KEY).
# If unset, read endpoints fall back to accepting LOADS_API_KEY only.
# Generate separately: python -c "import secrets; print(secrets.token_urlsafe(32))"
READ_API_KEY=your-read-api-key-here

# FMCSA API key for carrier authority verification.
FMCSA_API_KEY=your-fmcsa-api-key-here

# SQLite database path (relative to backend/ when running uvicorn from there).
# Default is fine for local dev; override in production if needed.
DATABASE_URL=sqlite+aiosqlite:///./carrier_sales.db

# -------------------------------------------------------------------------
# Frontend (frontend/.env) — copy and fill separately
# -------------------------------------------------------------------------
# Base URL of the API. Leave empty when served by the same origin (production).
# Set to http://localhost:8000 only if running frontend dev server separately.
VITE_API_BASE=

# Must match READ_API_KEY (read-only key). Never use LOADS_API_KEY here.
VITE_API_KEY=your-read-api-key-here
